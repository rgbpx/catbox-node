{
  "$schema": "./node_modules/release-it/schema/release-it.json",
  "git": {
    "releaseName": "${version}",
    "tagName": "${version}",
    "commitMessage": "chore: release ${version}"
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": true,
    "skipChecks": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features"
          },
          {
            "type": "fix",
            "section": "Bug Fixes"
          },
          {
            "type": "docs",
            "section": "Documentation"
          },
          {
            "type": "style",
            "section": "Style"
          },
          {
            "type": "refactor",
            "section": "Refactoring"
          },
          {
            "type": "test",
            "section": "Tests"
          },
          {
            "type": "perf",
            "section": "Performance"
          },
          {
            "type": "chore",
            "effect": "hidden"
          }
        ]
      }
    }
  }
}
